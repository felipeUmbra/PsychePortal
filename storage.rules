rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /patients/{psychologistId}/{patientId}/{allPaths=**} {
      // Only the owning psychologist can read/write to their patient's storage path
      allow read, write: if request.auth != null && request.auth.uid == psychologistId;

      // Limit file size to 40MB
      allow write: if request.resource.size < 40 * 1024 * 1024;
    }
  }
}
